# Supabase project URL, e.g. https://eujrkroskvxvqrxrpaai.supabase.co
SUPABASE_URL=
# Service role key (Supabase > Project Settings > API). Server-only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: your main domain, used in pass links and QR codes
NEXT_PUBLIC_SITE_URL=
# Set to true once online payment is built
NEXT_PUBLIC_ONLINE_PAYMENT=false
